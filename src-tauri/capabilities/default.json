{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    "dialog:allow-save",
    { "identifier": "fs:allow-write-text-file", "allow": [{ "path": "**" }] },
    { "identifier": "fs:allow-copy-file", "allow": [{ "path": "$APPDATA/**" }] },
    { "identifier": "fs:allow-mkdir", "allow": [{ "path": "$APPDATA/**" }] },
    { "identifier": "fs:allow-exists", "allow": [{ "path": "$APPDATA/**" }] }
  ]
}